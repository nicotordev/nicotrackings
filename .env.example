# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Parcels API key (https://parcelsapp.com/developers/docs). Sent as Authorization: Bearer.
PARCELS_API_KEY=your_parcels_api_key_here

# Optional default destination country (ISO-2). /track NUMBER ES also sets it per package.
# PARCELS_DESTINATION_COUNTRY=ES

# PostgreSQL connection string (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nicotrackings"

# Cron schedule for polling package status updates (default: every 15 minutes)
POLL_INTERVAL_CRON="*/15 * * * *"

# Optional override. On Railway the bot uses https://$RAILWAY_PUBLIC_DOMAIN/webhooks/parcels
# PARCELS_WEBHOOK_URL=https://nicotrackings-production.up.railway.app/webhooks/parcels
# WEBHOOK_PORT=3000
