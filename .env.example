# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 17TRACK API Configuration
# Register at https://api.17track.net/en/register and get your API key
TRACK17_API_KEY=your_17track_api_key_here

# Database Configuration
# SQLite (default for development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/package_tracker?schema=public"

# Polling Configuration
# Interval in milliseconds to check for package updates (default: 5 minutes)
POLL_INTERVAL_MS=300000

# Webhook Configuration (optional)
# Enable webhook mode instead of polling (set to 'true' to enable)
WEBHOOK_ENABLED=false
# The URL where 17TRACK will send webhook notifications
WEBHOOK_URL=https://your-domain.com/webhook
# Secret for webhook signature verification
WEBHOOK_SECRET=your_webhook_secret_here
# Port for webhook server
WEBHOOK_PORT=3000

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=development
