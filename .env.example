# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# 17TRACK API Security Key (obtain from https://api.17track.net/)
TRACKING_API_KEY=your_17track_api_key_here

# PostgreSQL connection string (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nicotrackings"

# Cron schedule for polling package status updates (default: every 15 minutes)
POLL_INTERVAL_CRON="*/15 * * * *"

# Optional public webhook for 17TRACK TRACKING_UPDATED / TRACKING_STOPPED pushes.
# Point the dashboard webhook URL at http://<host>:<port>/webhooks/17track
# WEBHOOK_PORT=3000
