{
  "name": "nicotrackings",
  "version": "1.0.0",
  "description": "Telegram bot to track international packages with automatic status notifications",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "prisma db update --yes && bun index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --outdir ./dist --target node",
    "db:emit": "prisma contract emit",
    "db:generate": "prisma contract emit",
    "db:push": "prisma db update",
    "db:migrate": "prisma migration plan",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "railway": "^3.16.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "prisma": "8.0.0-rc.27",
    "zod": "^4.6.7"
  }
}
